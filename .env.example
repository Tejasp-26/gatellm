# Copy this file to .env and change the values. NEVER commit .env
PORT=8080
LOG_LEVEL=info

# Local (docker-compose) values. In production use Neon and Upstash URLs.
DATABASE_URL=postgres://gatellm:gatellm@localhost:5432/gatellm?sslmode=disable
REDIS_URL=redis://localhost:6379

# Protects /admin/* endpoints. Use a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Biggest request body in bytes (default 1048576 = 1 MB)
MAX_BODY_BYTES=1048576

# Provider keys. Leave empty to disable that provider. The mock provider is always on.
GROQ_API_KEY=
GEMINI_API_KEY=

# Mock provider: fake delay in milliseconds and failure rate (0 = never, 1 = always)
MOCK_LATENCY_MS=200
MOCK_ERROR_RATE=0
