# Copy this file to .env and change the values. NEVER commit .env
PORT=8080
LOG_LEVEL=info

# Local (docker-compose) values. In production use Neon and Upstash URLs.
DATABASE_URL=postgres://gatellm:gatellm@localhost:5432/gatellm?sslmode=disable
REDIS_URL=redis://localhost:6379

# Protects /admin/* endpoints. Use a long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Biggest request body in bytes (default 1048576 = 1 MB)
MAX_BODY_BYTES=1048576

# Provider keys. Leave empty to disable that provider. The mock provider is always on.
GROQ_API_KEY=
GEMINI_API_KEY=

# Mock provider: fake delay in milliseconds and failure rate (0 = never, 1 = always)
MOCK_LATENCY_MS=200
MOCK_ERROR_RATE=0

# Rate limiting: what to do when Redis is down.
#   closed = reject requests with 503 (safe for your quota and money) - default
#   open   = let requests pass without limits (keeps the service up)
RATE_LIMIT_ON_REDIS_DOWN=closed
# Max time for one rate limit check in Redis, in milliseconds
RATE_LIMIT_TIMEOUT_MS=500

# Reliability. Every provider gets a timeout, retries and a circuit breaker.
# Max time for ONE attempt in milliseconds (for streams: until the stream starts)
PROVIDER_TIMEOUT_MS=30000
# Optional different timeout for one provider (empty = use PROVIDER_TIMEOUT_MS)
GROQ_TIMEOUT_MS=
GEMINI_TIMEOUT_MS=
# Total tries per request including the first one (3 = first try + 2 retries)
RETRY_MAX_ATTEMPTS=3
# Wait before the first retry, doubles each time, never above RETRY_MAX_MS
RETRY_BASE_MS=200
RETRY_MAX_MS=2000
# This many failures in a row open the circuit breaker, then it waits this long before a test call
BREAKER_FAILURES=5
BREAKER_COOLDOWN_SECONDS=30

# Routing: clients that send "model": "auto" are served by the router, with fallback.
#   priority = always the first target, the others only when it fails
#   weighted = share the traffic by weight (groq/llama:3,gemini/gemini-2.5-flash:1 -> 3 out of 4 to groq)
#   latency  = the target with the lowest recent average latency goes first
ROUTE_STRATEGY=priority
# Order = priority. Format: provider/model[:weight]. Empty = every enabled real provider, or mock.
# For tests with the mocks:  ROUTE_TARGETS=mock,mock-b
ROUTE_TARGETS=
# Ping the providers every N seconds (costs no tokens). 0 = off.
HEALTH_CHECK_INTERVAL_SECONDS=30
# A second mock called "mock-b", to test fallback (make "mock" fail with MOCK_ERROR_RATE=1)
MOCK_B_LATENCY_MS=200
MOCK_B_ERROR_RATE=0

# Cache: the same question (temperature 0) is answered from Redis, without calling the provider.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# true = also cache requests with temperature above 0 (the answer then stops being fresh each time)
CACHE_ALLOW_TEMPERATURE=false
CACHE_TIMEOUT_MS=200

# Semantic cache: a question that is ALMOST the same as an old one gets the old answer (X-Cache: HIT-SEMANTIC).
# It needs CACHE_ENABLED=true and a Postgres with pgvector. Off by default.
SEMANTIC_CACHE_ENABLED=false
# 0.92 = very similar. Lower = more hits but more wrong answers. Higher = safer.
SEMANTIC_THRESHOLD=0.92
SEMANTIC_TIMEOUT_MS=1000
# mock = fake embeddings from word hashes (no key, only matches texts that share words)
# gemini = real embeddings (gemini-embedding-001), uses GEMINI_API_KEY
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TIMEOUT_MS=3000

# Usage events: every request puts one event in a Redis Stream and returns at once.
# A background consumer writes the events to the Postgres table usage_events.
USAGE_PIPELINE_ENABLED=true
USAGE_BATCH_SIZE=50
# How long one read waits for new events. On Upstash (free plan: 500,000 commands per month)
# use a long wait, for example 30000, because every read is one command.
USAGE_POLL_MS=5000
# true = Redis holds the read open until an event arrives. false = no blocking, we sleep USAGE_POLL_MS between reads.
USAGE_BLOCKING_READ=true
# A message that was read but never confirmed for this long is taken over from a dead consumer.
USAGE_CLAIM_IDLE_SECONDS=30
# At shutdown the consumer writes the events that are left, for at most this long.
USAGE_DRAIN_SECONDS=10
# The stream keeps about this many events. If the consumer is dead for a long time, the OLDEST are dropped.
USAGE_STREAM_MAXLEN=100000
USAGE_PUBLISH_TIMEOUT_MS=500
